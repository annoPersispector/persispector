# Copy this file to .env and replace values as needed.
# Environment variables already exported by the shell take precedence.

# OpenAI-compatible model provider
API_KEY=
BASE_URL=https://openrouter.ai/api/v1
IPD_STUDY_MODEL=openai/gpt-4o
PERSISTENCE_MODEL=openai/gpt-4o

# Optional fallback when a task-specific model is unset
LLM_MODEL=

# Structured-output retry and cache settings
LLM_PARSE_RETRIES=3
ENABLE_LLM_CACHE=true
LLM_CACHE_DIR=.llm_cache

# Optional CodeQL CLI override for persistence taint-flow analysis
CODEQL_COMMAND=codeql

# Directory used for isolated runtime-verification tasks
PERSISPECTOR_ISOLATION_ROOT=.persispector-verification
